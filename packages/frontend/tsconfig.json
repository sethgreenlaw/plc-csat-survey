{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@examples/*": ["../../examples/*"],
      "@mui/material": ["./node_modules/@mui/material"],
      "@mui/material/*": ["./node_modules/@mui/material/*"],
      "@mui/lab": ["./node_modules/@mui/lab"],
      "@mui/lab/*": ["./node_modules/@mui/lab/*"],
      "@opengov/*": ["./node_modules/@opengov/*"],
      "react-router": ["./node_modules/react-router"],
      "react-router/*": ["./node_modules/react-router/*"]
    },
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["src/**/*", "../../examples/layouts/**/*", "../../examples/pages/**/*"],
  "references": [{ "path": "../protocol" }]
}
